# Copy to .env for local testing (never commit .env). In GitHub these are Secrets.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
ALERT_EMAIL_TO=you@gmail.com
# Carrier email-to-text gateway. Examples:
#   Verizon  5551234567@vtext.com
#   AT&T     5551234567@txt.att.net
#   T-Mobile 5551234567@tmomail.net
#   Google Fi 5551234567@msg.fi.google.com
#   US Cellular 5551234567@email.uscc.net
ALERT_SMS_TO=5551234567@vtext.com

# Optional: switch texts to Twilio later
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15551234567
# TWILIO_TO=+15557654321
